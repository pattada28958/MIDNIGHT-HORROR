<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>The Film Archive</title>
    <!-- ใช้ฟอนต์สไตล์ Criterion -->
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Sarabun:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #f7f6f2; /* สีพื้นหลังสไตล์กระดาษ/มินิมอล */
            --text-color: #222;
            --accent-color: #d92525; /* สีแดงสไตล์ Criterion */
            --border-color: #ddd;
        }

        body {
            font-family: 'Sarabun', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
        }

        h1, h2, h3, .serif {
            font-family: 'Playfair Display', serif;
        }

        /* --- Header & Stats --- */
        header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }
        
        header h1 {
            font-size: 3rem;
            margin: 0 0 10px 0;
            letter-spacing: 2px;
        }

        .stats {
            display: flex;
            justify-content: center;
            gap: 20px;
            font-size: 0.9rem;
            color: #555;
            margin-bottom: 20px;
        }

        .stats div {
            padding: 5px 15px;
            border-left: 2px solid var(--accent-color);
        }

        /* --- Controls (Search & Filter) --- */
        .controls {
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 30px;
        }

        input, select, button, textarea {
            padding: 8px 12px;
            font-family: 'Sarabun', sans-serif;
            border: 1px solid var(--border-color);
            background: #fff;
            border-radius: 4px;
        }

        button {
            cursor: pointer;
            background-color: var(--text-color);
            color: #fff;
            border: none;
            transition: 0.2s;
        }

        button:hover {
            background-color: var(--accent-color);
        }

        /* --- Movie Grid & Cards --- */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }

        .card {
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 4px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            position: relative;
            cursor: pointer;
        }

        /* 🎬 โปสเตอร์แบบ hover ซูม */
        .poster-wrapper {
            width: 100%;
            height: 330px;
            overflow: hidden;
            position: relative;
        }

        .poster-wrapper img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 15px rgba(0,0,0,0.1);
        }

        .card:hover .poster-wrapper img {
            transform: scale(1.08); /* ขยายภาพนิดหน่อยเมื่อโฮเวอร์ */
        }

        /* 🏷️ Badge สถานะ */
        .badge {
            position: absolute;
            top: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.7);
            color: #fff;
            padding: 4px 8px;
            font-size: 0.75rem;
            border-radius: 12px;
            z-index: 10;
            cursor: pointer;
            user-select: none;
        }
        .badge.ดูแล้ว { background: #28a745; }
        .badge.อยากดู { background: var(--accent-color); }
        .badge.ยังไม่ดู { background: #6c757d; }

        .card-info {
            padding: 15px;
        }

        .card-title {
            font-size: 1.2rem;
            margin: 0 0 5px 0;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .card-meta {
            font-size: 0.8rem;
            color: #777;
            margin-bottom: 10px;
        }

        /* ⭐ เรตติ้ง */
        .ratings {
            font-size: 0.8rem;
            display: flex;
            justify-content: space-between;
            border-top: 1px solid var(--border-color);
            padding-top: 10px;
            margin-top: 10px;
        }
        .ratings span { font-weight: bold; }

        /* --- Modal (ฟอร์มเพิ่ม/แก้ไข) --- */
        dialog {
            border: none;
            border-radius: 8px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.2);
            padding: 30px;
            width: 90%;
            max-width: 500px;
            background: var(--bg-color);
        }
        
        dialog::backdrop {
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(3px);
        }

        .form-group {
            margin-bottom: 15px;
            display: flex;
            flex-direction: column;
        }

        .form-group label {
            font-size: 0.9rem;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-row {
            display: flex;
            gap: 10px;
        }
        .form-row .form-group { flex: 1; }

        .dialog-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <header>
        <h1 class="serif">The Film Archive</h1>
        <!-- 📊 สถิติด้านบน -->
        <div class="stats" id="stats-container">
            <!-- Render by JS -->
        </div>
        
        <!-- 🔍 ค้นหา + กรอง -->
        <div class="controls">
            <input type="text" id="search-input" placeholder="ค้นหาชื่อภาพยนตร์..." oninput="renderMovies()">
            <select id="filter-genre" onchange="renderMovies()">
                <option value="">ทุกประเภท</option>
                <option value="Horror">Horror</option>
                <option value="Thriller">Thriller</option>
                <option value="Action">Action</option>
                <option value="Drama">Drama</option>
            </select>
            <select id="filter-status" onchange="renderMovies()">
                <option value="">ทุกสถานะ</option>
                <option value="ดูแล้ว">ดูแล้ว</option>
                <option value="อยากดู">อยากดู</option>
                <option value="ยังไม่ดู">ยังไม่ดู</option>
            </select>
            <button onclick="openModal()">+ เพิ่มภาพยนตร์</button>
        </div>
    </header>

    <!-- พื้นที่แสดงการ์ดหนัง -->
    <main class="grid" id="movie-grid"></main>

    <!-- ✏️ Modal เพิ่ม/แก้ไขหนัง -->
    <dialog id="movie-modal">
        <h2 class="serif" id="modal-title">เพิ่มภาพยนตร์</h2>
        <form id="movie-form" onsubmit="saveMovie(event)">
            <input type="hidden" id="movie-id">
            
            <div class="form-group">
                <label>ชื่อภาพยนตร์</label>
                <input type="text" id="m-title" required>
            </div>
            
            <div class="form-row">
                <div class="form-group">
                    <label>ปีที่ฉาย</label>
                    <input type="number" id="m-year" required>
                </div>
                <div class="form-group">
                    <label>ประเภท (Genre)</label>
                    <input type="text" id="m-genre" placeholder="เช่น Horror, Thriller" required>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>ประเทศ</label>
                    <input type="text" id="m-country" required>
                </div>
                <div class="form-group">
                    <label>สถานะ</label>
                    <select id="m-status">
                        <option value="ยังไม่ดู">ยังไม่ดู</option>
                        <option value="ดูแล้ว">ดูแล้ว</option>
                        <option value="อยากดู">อยากดู</option>
                    </select>
                </div>
            </div>

            <div class="form-group">
                <label>URL โปสเตอร์หนัง</label>
                <input type="url" id="m-poster" placeholder="https://..." required>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>IMDb Rating</label>
                    <input type="number" step="0.1" max="10" id="m-imdb">
                </div>
                <div class="form-group">
                    <label>Rotten Tomatoes (%)</label>
                    <input type="number" max="100" id="m-rt">
                </div>
                <div class="form-group">
                    <label>คะแนนส่วนตัว (10)</label>
                    <input type="number" step="0.5" max="10" id="m-personal">
                </div>
            </div>

            <div class="form-group">
                <label>รีวิวสั้น ๆ / บันทึกย่อ</label>
                <textarea id="m-review" rows="3"></textarea>
            </div>

            <div class="dialog-actions">
                <button type="button" onclick="closeModal()" style="background:#ccc; color:#000;">ยกเลิก</button>
                <button type="button" id="btn-delete" onclick="deleteMovie()" style="background:var(--accent-color); display:none;">ลบข้อมูล</button>
                <button type="submit">บันทึกข้อมูล</button>
            </div>
        </form>
    </dialog>

    <script>
        // 💾 บันทึกและดึงข้อมูลจาก localStorage (แถมข้อมูลเริ่มต้นให้เห็นภาพ)
        const defaultData = [
            { id: 1680000000000, title: "The Evil Dead", year: 1981, genre: "Horror", country: "USA", status: "ดูแล้ว", imdb: 7.4, rt: 95, personal: 9.0, review: "คลาสสิก ดิบ และเป็นการเปิดตำนาน", poster: "https://image.tmdb.org/t/p/w500/iSihHkZ0qG1R0T2z8QItlBnm9lG.jpg" },
            { id: 1680000000001, title: "Resident Evil", year: 2002, genre: "Horror", country: "Germany/UK", status: "ดูแล้ว", imdb: 6.6, rt: 35, personal: 7.5, review: "บรรยากาศดี แอคชั่นสนุก", poster: "https://image.tmdb.org/t/p/w500/ftmDEXNla0w8A0pXXtP05g7L1z8.jpg" },
            { id: 1680000000002, title: "Parasite", year: 2019, genre: "Thriller", country: "South Korea", status: "อยากดู", imdb: 8.5, rt: 99, personal: "", review: "", poster: "https://image.tmdb.org/t/p/w500/7IiTTgloJzvGI1TAYymCfbfl3vT.jpg" }
        ];

        let movies = JSON.parse(localStorage.getItem('criterion_movies'));
        if (!movies) {
            movies = defaultData;
            saveToStorage();
        }

        const modal = document.getElementById('movie-modal');

        function saveToStorage() {
            localStorage.setItem('criterion_movies', JSON.stringify(movies));
        }

        // 📊 อัปเดตสถิติ
        function updateStats() {
            const total = movies.length;
            const watched = movies.filter(m => m.status === 'ดูแล้ว').length;
            const want = movies.filter(m => m.status === 'อยากดู').length;
            
            // หาค่าเฉลี่ยคะแนนส่วนตัวเฉพาะเรื่องที่มีคะแนน
            const ratedMovies = movies.filter(m => m.personal !== "" && m.personal !== null);
            const avgRating = ratedMovies.length > 0 
                ? (ratedMovies.reduce((sum, m) => sum + Number(m.personal), 0) / ratedMovies.length).toFixed(1) 
                : '-';

            document.getElementById('stats-container').innerHTML = `
                <div><strong>${total}</strong> ทั้งหมด</div>
                <div><strong>${watched}</strong> ดูแล้ว</div>
                <div><strong>${want}</strong> อยากดู</div>
                <div><strong>${avgRating}</strong> เรตติ้งเฉลี่ย</div>
            `;
        }

        // เปลี่ยนสถานะโดยการคลิกที่ Badge
        function toggleStatus(event, id) {
            event.stopPropagation(); // ป้องกันไม่ให้ทะลุไปคลิกเปิดการ์ดแก้ไข
            const movie = movies.find(m => m.id === id);
            if(movie.status === 'ยังไม่ดู') movie.status = 'อยากดู';
            else if(movie.status === 'อยากดู') movie.status = 'ดูแล้ว';
            else movie.status = 'ยังไม่ดู';
            
            saveToStorage();
            renderMovies();
        }

        // เปิดการ์ดเพื่อแก้ไข
        function editMovie(id) {
            const movie = movies.find(m => m.id === id);
            document.getElementById('movie-id').value = movie.id;
            document.getElementById('m-title').value = movie.title;
            document.getElementById('m-year').value = movie.year;
            document.getElementById('m-genre').value = movie.genre;
            document.getElementById('m-country').value = movie.country;
            document.getElementById('m-status').value = movie.status;
            document.getElementById('m-poster').value = movie.poster;
            document.getElementById('m-imdb').value = movie.imdb;
            document.getElementById('m-rt').value = movie.rt;
            document.getElementById('m-personal').value = movie.personal;
            document.getElementById('m-review').value = movie.review;

            document.getElementById('modal-title').innerText = "แก้ไขข้อมูล";
            document.getElementById('btn-delete').style.display = "block";
            modal.showModal();
        }

        function openModal() {
            document.getElementById('movie-form').reset();
            document.getElementById('movie-id').value = '';
            document.getElementById('modal-title').innerText = "เพิ่มภาพยนตร์ใหม่";
            document.getElementById('btn-delete').style.display = "none";
            modal.showModal();
        }

        function closeModal() {
            modal.close();
        }

        // บันทึก/อัปเดตข้อมูล
        function saveMovie(e) {
            e.preventDefault();
            const id = document.getElementById('movie-id').value;
            const movieData = {
                id: id ? Number(id) : Date.now(),
                title: document.getElementById('m-title').value,
                year: document.getElementById('m-year').value,
                genre: document.getElementById('m-genre').value,
                country: document.getElementById('m-country').value,
                status: document.getElementById('m-status').value,
                poster: document.getElementById('m-poster').value,
                imdb: document.getElementById('m-imdb').value,
                rt: document.getElementById('m-rt').value,
                personal: document.getElementById('m-personal').value,
                review: document.getElementById('m-review').value
            };

            if (id) {
                const index = movies.findIndex(m => m.id === Number(id));
                movies[index] = movieData;
            } else {
                movies.push(movieData);
            }

            saveToStorage();
            closeModal();
            renderMovies();
        }

        // ลบภาพยนตร์
        function deleteMovie() {
            if(confirm('ต้องการลบภาพยนตร์เรื่องนี้ใช่หรือไม่?')) {
                const id = document.getElementById('movie-id').value;
                movies = movies.filter(m => m.id !== Number(id));
                saveToStorage();
                closeModal();
                renderMovies();
            }
        }

        // แสดงผลหนัง + กรองค้นหา
        function renderMovies() {
            const grid = document.getElementById('movie-grid');
            const searchQ = document.getElementById('search-input').value.toLowerCase();
            const genreF = document.getElementById('filter-genre').value.toLowerCase();
            const statusF = document.getElementById('filter-status').value;

            grid.innerHTML = '';
            updateStats();

            const filteredMovies = movies.filter(m => {
                const matchSearch = m.title.toLowerCase().includes(searchQ);
                const matchGenre = genreF ? m.genre.toLowerCase().includes(genreF) : true;
                const matchStatus = statusF ? m.status === statusF : true;
                return matchSearch && matchGenre && matchStatus;
            });

            filteredMovies.forEach(movie => {
                const card = document.createElement('div');
                card.className = 'card';
                card.onclick = () => editMovie(movie.id);

                card.innerHTML = `
                    <div class="badge ${movie.status}" onclick="toggleStatus(event, ${movie.id})">${movie.status}</div>
                    <div class="poster-wrapper">
                        <img src="${movie.poster}" alt="${movie.title}">
                    </div>
                    <div class="card-info">
                        <h3 class="card-title serif">${movie.title}</h3>
                        <div class="card-meta">${movie.year} • ${movie.country} • ${movie.genre}</div>
                        
                        <div class="ratings">
                            <div>IMDb: <span>${movie.imdb || '-'}</span></div>
                            <div>RT: <span>${movie.rt ? movie.rt+'%' : '-'}</span></div>
                            <div style="color:var(--accent-color);">Me: <span>${movie.personal || '-'}</span>/10</div>
                        </div>
                        
                        ${movie.review ? `<p style="font-size:0.8rem; color:#666; margin-top:10px; font-style:italic;">"${movie.review}"</p>` : ''}
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // เรียกใช้งานครั้งแรก
        renderMovies();
    </script>
</body>
</html>
